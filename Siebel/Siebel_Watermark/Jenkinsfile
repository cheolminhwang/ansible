pipeline {
    agent {
	 node{
	label 'built-in'
	customWorkspace '/tmp/watermark'
	 }
	}
      environment {
       def watermark = ""
       def packageFolder = "/tmp"
       def repo_name = "bpm"
       def filename = "${env.Environment}_${env.File_Name}"
    }
    stages {
		stage('Cleanup') {
            steps {
                cleanWs()  // Deletes workspace contents
            }
        }
		stage('Checkout') {
			steps {
				checkout scm
			}			
        }
		stage('Environment Name') {
		  steps {
			echo "Variables: ${env.Environment}"
			}
		}
        stage('Target Environment Watermark') {
            steps {
                // Use withCredentials to securely handle the username and password
                withCredentials([usernamePassword(credentialsId: "${env.Environment}_SADMIN", usernameVariable: 'USER', passwordVariable: 'PASS')]) {
                    script {
                        def apiUrl = "https://${Host_Name}:4430/siebel/v1.0/service/Migration%20Incremental%20Runtime%20Repository%20Data%20Service/GetWatermark"
                        
                        // Write the request body to a file to avoid shell escaping issues
                        writeFile file: 'request.json', text: '{"body":{}}'

                        // Execute curl with the file-based data flag (-d @file)
                        def response = sh(
                            script: """
                                curl -s --insecure -X POST "${apiUrl}" \
                                    -u "${USER}:${PASS}" \
                                    -H 'Content-Type: application/json' \
                                    -d @request.json
                            """,
                            returnStdout: true
                        ).trim()

                        // Parse the JSON response
                        if (response && response.startsWith("{")) {
                            def json = readJSON text: response
                            
                            // Siebel Migration API typically returns { "watermark": "VALUE" }
                            watermark = json.watermark
                            
                            if (watermark) {
                                echo "Target Environment Watermark: ${watermark}"
                                echo "Writing to: ${WORKSPACE}/tmp_repo/${filename} with value: ${watermark}"
                           
                                // Use writeFile to overwrite or append the watermark to your tracking file
                                sh "mkdir -p ${WORKSPACE}/tmp_repo"  
                                writeFile file: "${WORKSPACE}/${filename}", text: watermark 
                            } else {
                                error "Watermark not found in response: ${response}"
                            }
                        } else {
                            error "Invalid response received from API: ${response}"
                        }
                    }
                }
            }
        }
        stage('=================================Git push') {
           	steps{
                withCredentials([string(credentialsId: 'github_access_token_secret', variable: 'GIT_TOKEN')]) { 
                    script {
                        //  Git commands to add, commit, and push
                        sh """
                            
                            cd '${WORKSPACE}'/tmp_repo
                            git clone --filter=blob:none --sparse https://x-token-auth:$GIT_TOKEN@github.com/cheolminhwang/'${repo_name}'.git --branch '${env.BRANCH_NAME}'
                            cd '${repo_name}'
                            git sparse-checkout set DeploymentArtifacts
                            cp '${WORKSPACE}'/${filename} DeploymentArtifacts/'${filename}'
                            git add DeploymentArtifacts/'${filename}'
                            
                            # Only commit if there are changes to avoid 'nothing to commit' errors
                            if ! git diff-index --quiet HEAD; then
                                git config user.email "jenkins@yourcompany.com"
                                git config user.name "Jenkins Build Bot"
                                git commit -m "Update Target Environment Watermark: ${watermark}"
                                
                                # Push back to the current branch
                                git push origin HEAD:'${env.BRANCH_NAME}'
                            else
                                echo "No changes in watermark; skipping git commit."
                            fi
                        """
                    }
                }
            }	
        }
    }
}

 