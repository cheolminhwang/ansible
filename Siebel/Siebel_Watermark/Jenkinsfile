pipeline {
    agent {
	 node{
	label 'built-in'
	customWorkspace '/tmp/watermark'
	 }
	}
      environment {
       def watermark = ""
    }
    stages {
		stage('Cleanup') {
            steps {
                cleanWs()  // Deletes workspace contents
            }
        }
		stage('Environment Name') {
		  steps {
			echo "Variables: ${env.Environment}"
			}
		}
		stage('Target Environment Watermark') {
            steps {
                withCredentials([usernamePassword(credentialsId: "${env.Environment}_SADMIN", usernameVariable: 'USER', passwordVariable: 'PASS')]) {
                    script {
                        def apiUrl = "https://${Host_Name}:4430/siebel/v1.0/service/Migration%20Incremental%20Runtime%20Repository%20Data%20Service/GetWatermark"
                        def jsonBody = """
						{
							 "body":
							 { 
							}
							}
						"""

                        def response = sh(
                            script: """
                                curl -s -X POST '${apiUrl}' \\
                                     -u "$USER:$PASS" \\
                                     -H 'Content-Type: application/json' \\
                                     -d '${jsonBody}'
                            """,
                            returnStdout: true
                        ).trim()
                       	def json = readJSON text: response
                       	watermark=json.watermark
                        echo "Target Environment Watermark:${watermark}"    
                        cat watermark >> "${customWorkspace}/watermark.txt"           
                    }
                }
            }
        }
		stage('=================================Initiate Watermark job after import') {
            when {
                expression { watermark != null && watermark != "" }
            }
            steps {
                build job: 'Siebel_Migration_File',  
                      wait: true,             // Wait for completion (default)
                      propagate: true,        // Propagate failure back to this pipeline (default)
                      parameters: [
                          string(name: 'Environment', value: "${env.Environment}"), 
                          string(name: 'Branch_Name', value: "${env.Branch_Name}"), 
                          string(name: 'packageFolder', value: "${customWorkspace}"), 
                          string(name: 'packageFilename', value: "watermark.txt") //${env.Environment}_watermark.txt
                      ]
            }
        }
	  }	
    }
}