pipeline {
    agent {
	 	node{
			label 'built-in'
			customWorkspace '/tmp/siebel_import'
	 	}
	}
    environment {
       	//def Ansible_Host_Name = "app_server_01"
	   	def Repo_Name = "bpm"
		def error_message = ""
	   	def History_ID = ""
    }
    stages {
		stage('Checkout devops automation repository') {
			steps{			
				checkout scm			
			}
	    }
		stage('Environment Name') {
		  	steps {
				echo "Variables: ${env.Environment},${env.Branch_Name},${env.Mig_Plan_Name},${env.packageFilename},${env.packageFilename}"
			}
		}
		
        stage('Git pull and place to sfs folder') {
            steps{
                withCredentials([string(credentialsId: 'github_access_token_secret', variable: 'GITHUB_TOKEN')]) { 
                    ansiColor('xterm') {
                        ansiblePlaybook(
                            playbook: "${WORKSPACE}/Siebel_Migration_Import_IRR/ansible_scripts/package_copy.yml",
                            inventory: "${WORKSPACE}/Siebel_Migration_Import_IRR/ansible_scripts/Inventory/siebel_env.yml",
                            colorized: true,
                            extraVars: [
                                env: "${env.Environment}",
                                repo_name: "bpm",
								packageFilename: "${env.packageFilename}",
                                git_token: "${GITHUB_TOKEN}",
                                Branch_Name: "${Branch_Name}"
                            ]
                        )
                    }
                }
            }	
        }

/* 
		stage('Git Clone of Siebel repository') {
			steps {
				script {
					withCredentials([string(credentialsId: 'github_access_token_secret', variable: 'BITBUCKET_TOKEN')]) {
						//sh("git clone https://x-token-auth:${BITBUCKET_TOKEN}@${GIT_FQDN}/dhs-kolea/sbl_code_repo.git --branch ${env.Branch_Name}")
						def response = sh(
							script: """
								rm -rf ${Repo_Name}						 
								git clone --filter=blob:none --sparse https://x-token-auth:${BITBUCKET_TOKEN}@github.com/cheolminhwang/${Repo_Name}.git --branch ${env.Branch_Name}
