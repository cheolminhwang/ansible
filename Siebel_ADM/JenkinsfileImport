pipeline {
    agent {
	 node{
	label 'built-in'
	customWorkspace '/stage/asi/automations/Siebel_ADM'
	 }
	}
      environment {
       
	   def status = ""

    }
    stages {
		stage('Cleanup') {
            steps {
                cleanWs()  // Deletes workspace contents
            }
        }
		stage('Environment Name') {
		  	steps {
				echo "Variables: ${env.Environment},${env.sessionid},${env.Branch_Name}"
		  	}
		}
		
		stage('Checkout devops automation repository') {
			steps{
			
				checkout scm
			
			}
	    }
		stage('Git Clone of Siebel repository') {
			steps {
				script {
					withCredentials([string(credentialsId: 'kolea_bitbucket_access_token_secret', variable: 'BITBUCKET_TOKEN')]) {
						//sh("git clone https://x-token-auth:${BITBUCKET_TOKEN}@${MY_GIT_FQDN}/dhs-kolea/sbl_code_repo.git --branch ${env.Branch_Name}")
						def response = sh(
                            script: """
								rm -rf sbl_code_repo
								git clone --filter=blob:none --sparse https://x-token-auth:${BITBUCKET_TOKEN}@${MY_GIT_FQDN}/dhs-kolea/sbl_code_repo.git --branch ${env.Branch_Name}
						    	cd sbl_code_repo
                                git sparse-checkout set DeploymentArtifacts                   
                            """,
                            returnStdout: true
                        ).trim() 
                        echo "response:${response}"               
					}
				}
			}
	  	}
		
		stage('Running Ansible to copy import folder') {
		 	steps{
				ansiColor('xterm') {
					ansiblePlaybook(
						playbook: "${WORKSPACE}/Siebel_ADM/ansible_scripts/SiebelADM_Import.yml",
						inventory: "${WORKSPACE}/Siebel_ADM/ansible_scripts/inventory/${env.Environment}/${env.Environment}.yml",
						colorized: true,
						extraVars: [
							env: "${env.Environment}",
							Repo_Name: "sbl_code_repo",
							sessionid: "${env.sessionid}",
							workspace: "${WORKSPACE}"
						]
					)
				}
		  	}	
		}
		
		stage('ADM Import') {
            steps {
                withCredentials([usernamePassword(credentialsId: "${env.Environment}_SADMIN", usernameVariable: 'USER', passwordVariable: 'PASS')]) {
                    script {
                        def apiUrl = "https://${Host_Name}:9112/siebel/v1.0/workflow/UDA%20Batch%20Import"
                        def jsonBody = """
							{
								"Object Id" : "${sessionid}",
								"Import File Directory" : "/u01/sfs/migration/ADM"
							}
						"""

                        def response = sh(
                            script: """
                                curl -s -X POST '${apiUrl}' \\
                                     -u "$USER:$PASS" \\
                                     -H 'Content-Type: application/json' \\
                                     -d '${jsonBody}'
                            """,
                            returnStdout: true
                        ).trim()
                       	def json = readJSON text: response
						repository_trackingid=json.trackingid
                        echo "Response:${json}"
                    }
                }
            }
        }
    }
}