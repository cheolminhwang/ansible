pipeline {
    agent {
		node{
			label 'built-in'
			customWorkspace '/tmp/Jenkins_Sec_Update'
		}
	}
    environment {       
	   	def url = ""
    }

    stages {
        stage('Initialize') {
            steps {
                script {
                    // Centralized logic: Set the URL once for the entire run
                     echo " Environment : ${env.Environment}"
                   switch (env.Environment) {
                        case 'prod':    env.JENKINS_URL = "https://build.dhsie.hawaii.gov"; break
                        case 'nonprod': env.JENKINS_URL = "https://build-nonp.dhsie.hawaii.gov"; break
                        default:        env.JENKINS_URL = "http://localhost:8088"; break
                    }
                    echo "Target Environment URL: ${env.JENKINS_URL}"
                }
            }
        }

        stage('Cleanup') {
            steps { deleteDir() }
        }

        stage('Checkout') {
            steps { checkout scm }
        }

        stage('Execution') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: 'jenkins-username-password', usernameVariable: 'J_USER', passwordVariable: 'J_PASS')]) {
                        def response = sh(
                            script: """
                                cd Jenkins_Sec_Update
                # 1. Clear out any old versions to avoid wildcard matching issues
                rm -f jenkins-plugin-manager-*.jar
                
                # 2. Fetch the standard Jenkins controller CLI
                wget -q "${JENKINS_URL}/jnlpJars/jenkins-cli.jar"
                
                # 3. Query the GitHub API to find the exact download URL of the latest asset
                echo "Querying GitHub API for the latest plugin manager version..."
                echo "$(curl -s https://github.com )"

                DOWNLOAD_URL=$(curl -s https://github.com | grep "browser_download_url" | cut -d '"' -f 4)
                
                if [ -z "$DOWNLOAD_URL" ]; then
                    echo "ERROR: Failed to retrieve the download URL from GitHub API."
                    exit 1
                fi
                
                # 4. Download the actual versioned file (e.g., jenkins-plugin-manager-2.15.0.jar)
                echo "Downloading from: $DOWNLOAD_URL"
                curl -L -O -s "$DOWNLOAD_URL"
                
                # 5. Dynamically find the file we just downloaded
                LATEST_JAR=$(ls jenkins-plugin-manager-*.jar | head -n 1)
                echo "Successfully downloaded tool: $LATEST_JAR"
                                python3 pyUpdatePlugins.py --user $J_USER --token jenkins --url ${env.JENKINS_URL}
                            """,
                            returnStdout: true
                        ).trim()
                        echo "Execution response: ${response}"
                        env.OUT = "OK"
                    }
                }
            }
        }

        stage('SafeRestart') {
            when { 
                expression { return env.OUT == "OK" }
            }
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: 'jenkins-username-password', usernameVariable: 'J_USER', passwordVariable: 'J_PASS')]) {
                        def response = sh(
                            script: """
                                cd Jenkins_Sec_Update
                                # Reusing the JENKINS_URL set in the first stage
                                bash ./shSafeRestart.sh ${env.JENKINS_URL} jenkins \$J_PASS
                            """,
                            returnStdout: true
                        ).trim()
                        // Note: Be careful echoing responses that might contain $J_PASS
                        echo "Restart triggered for ${env.JENKINS_URL}"
                    }
                }
            }
        }
    }
}
