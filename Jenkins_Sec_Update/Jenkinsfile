pipeline {
    agent {
        node {
            label 'built-in'
            customWorkspace '/tmp/Jenkins_Sec_Update'
        }
    }
    environment {
        // We define this here but will populate it in a script block
        JENKINS_URL = "dd"
    }
    stages {
        stage('Initialize') {
            steps {
                script {
                    // Centralized logic: Set the URL once for the entire run
                     echo " Environment : ${env.Environment}"
                   switch (env.Environment) {
                        case 'prod':    env.JENKINS_URL = "https://hawaii.gov"; break
                        case 'nonprod': env.JENKINS_URL = "http://localhost"; break
                        default:        env.JENKINS_URL = "https://hawaii.gov"; break
                    }
                    echo "Target Environment URL: ${env.JENKINS_URL}"
                }
            }
        }

        stage('Cleanup') {
            steps { deleteDir() }
        }

        stage('Checkout') {
            steps { checkout scm }
        }

        stage('Execution') {
            steps {
                script {
                    def response = sh(
                        script: """
                            cd Jenkins_Sec_Update
                            wget ${env.JENKINS_URL}/jnlpJars/jenkins-cli.jar
                            wget https://github.com
                            python3 pyUpdatePlugins.py
                        """,
                        returnStdout: true
                    ).trim()
                    echo "Execution response: ${response}"
                }
            }
        }

        stage('SafeRestart') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: 'jenkins-username-password', usernameVariable: 'J_USER', passwordVariable: 'J_PASS')]) {
                        def response = sh(
                            script: """
                                cd Jenkins_Sec_Update
                                # Reusing the JENKINS_URL set in the first stage
                                bash ./shSafeRestart.sh ${env.JENKINS_URL} jenkins \$J_PASS
                            """,
                            returnStdout: true
                        ).trim()
                        // Note: Be careful echoing responses that might contain $J_PASS
                        echo "Restart triggered for ${env.JENKINS_URL}"
                    }
                }
            }
        }
    }
}
