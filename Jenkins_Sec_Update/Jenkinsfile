pipeline {
    agent {
        node {
            label 'built-in'
            customWorkspace '/tmp/Jenkins_Sec_Update'
        }
    }

/*    parameters {
        choice(
            name: 'Environment',
            choices: ['nonprod', 'prod', 'local'],
            description: 'Target Jenkins environment'
        )
    } */

    environment {
        TARGET_JENKINS_URL = ''
        OUT = 'FAILED'
    }

    stages {
        stage('Initialize') {
            steps {
                script {
                    echo "Environment: ${params.Environment}"

                    switch (params.Environment) {
                        case 'prod':
                            env.TARGET_JENKINS_URL =
                                'https://build.dhsie.hawaii.gov'
                            break

                        case 'nonprod':
                            env.TARGET_JENKINS_URL =
                                'https://build-nonp.dhsie.hawaii.gov'
                            break

                        case 'local':
                            env.TARGET_JENKINS_URL =
                                'http://localhost:8088'
                            break

                        default:
                            error(
                                "Unsupported environment: ${params.Environment}"
                            )
                    }

                    echo "Target Jenkins URL: ${env.TARGET_JENKINS_URL}"
                }
            }
        }

        stage('Cleanup') {
            steps {
                deleteDir()
            }
        }

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Execution') {
            steps {
                script {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'jenkins-username-password',
                            usernameVariable: 'J_USER',
                            passwordVariable: 'J_PASS'
                        )
                    ]) {
                        withEnv([
                            "TARGET_URL=${env.TARGET_JENKINS_URL}"
                        ]) {
                            def response = sh(
                                script: '''
                                    set -eu

                                    echo "Workspace: $(pwd)"

                                    echo "Cleaning old plugin manager files..."
                                    rm -f jenkins-plugin-manager-*.jar
                                    rm -f jenkins-cli.jar

                                    echo "Downloading Jenkins CLI..."
                                    curl -fsSL \
                                        "${TARGET_URL%/}/jnlpJars/jenkins-cli.jar" \
                                        -o jenkins-cli.jar

                                    if [ ! -s jenkins-cli.jar ]; then
                                        echo "ERROR: Jenkins CLI download failed."
                                        exit 1
                                    fi

                                    echo "Querying GitHub API for latest plugin manager..."

                                    DOWNLOAD_URL=$(
                                        curl -fsSL \
                                            "https://api.github.com/repos/jenkinsci/plugin-installation-manager-tool/releases/latest" |
                                        grep '"browser_download_url":' |
                                        cut -d '"' -f 4 |
                                        grep '/jenkins-plugin-manager-[^/]*\\.jar$' |
                                        head -n 1
                                    )

                                    if [ -z "$DOWNLOAD_URL" ]; then
                                        echo "ERROR: Plugin manager URL not found."
                                        exit 1
                                    fi

                                    LATEST_JAR=$(basename "$DOWNLOAD_URL")

                                    echo "Downloading plugin manager: $LATEST_JAR"

                                    curl -fsSL \
                                        "$DOWNLOAD_URL" \
                                        -o "$LATEST_JAR"

                                    if [ ! -s "$LATEST_JAR" ]; then
                                        echo "ERROR: Plugin manager download failed."
                                        exit 1
                                    fi

                                    echo "Downloaded tool: $LATEST_JAR"

                                    python3 pyUpdatePlugins.py \
                                        --user "$J_USER" \
                                        --token "$J_PASS" \
                                        --url "$TARGET_URL"
                                ''',
                                returnStdout: true
                            ).trim()

                            echo "Execution response:\n${response}"
                            env.OUT = 'OK'
                        }
                    }
                }
            }
        }

        stage('Safe Restart') {
            when {
                expression {
                    env.OUT == 'OK'
                }
            }

            steps {
                script {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'jenkins-username-password',
                            usernameVariable: 'J_USER',
                            passwordVariable: 'J_PASS'
                        )
                    ]) {
                        withEnv([
                            "TARGET_URL=${env.TARGET_JENKINS_URL}"
                        ]) {
                            sh(
                                script: '''
                                    set -eu

                                    if [ ! -f ./shSafeRestart.sh ]; then
                                        echo "ERROR: shSafeRestart.sh not found."
                                        exit 1
                                    fi

                                    chmod +x ./shSafeRestart.sh

                                    ./shSafeRestart.sh \
                                        "$TARGET_URL" \
                                        "$J_USER" \
                                        "$J_PASS"
                                '''
                            )

                            echo "Restart triggered for ${env.TARGET_JENKINS_URL}"
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            echo "Pipeline completed successfully."
        }

        failure {
            echo "Pipeline failed."
        }

        always {
            echo "Final execution status: ${env.OUT}"
        }
    }
}